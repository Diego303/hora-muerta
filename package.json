{
  "name": "hora-muerta",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bank:build": "tsx scripts/build-bank.ts",
    "bank:group": "tsx scripts/build-group.ts",
    "bank:validate": "tsx scripts/validate-bank.ts",
    "bank:report": "tsx scripts/bank-report.ts",
    "drills:build": "tsx scripts/build-drills.ts",
    "drills:validate": "tsx scripts/validate-drills.ts"
  },
  "dependencies": {
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
